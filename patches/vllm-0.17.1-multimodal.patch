 class MultiModalProcessingInfo(BaseProcessingInfo):
+    def _resolve_processor_method(self, processor):
+        method = getattr(processor, "_get_num_multimodal_tokens", None)
+        if method is None:
+            import importlib, types as _types
+            _cls = getattr(
+                importlib.import_module(type(processor).__module__),
+                type(processor).__name__, None,
+            )
+            _unbound = getattr(_cls, "_get_num_multimodal_tokens", None) if _cls else None
+            if _unbound is not None:
+                method = _types.MethodType(_unbound, processor)
+        return method
+
+    def _processor_supports_audio(self) -> bool:
+        try:
+            proc = self.get_hf_processor()
+            method = self._resolve_processor_method(proc)
+            if method is None:
+                return False
+            result = method(audio_lengths=[16000])
+            return "num_audio_tokens" in result
+        except Exception:
+            return False
